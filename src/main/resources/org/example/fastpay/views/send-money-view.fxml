<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="750.0" prefWidth="1100.0" stylesheets="@../styles/application.css" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="org.example.fastpay.controllers.SendMoneyController">

    <left>
        <VBox alignment="TOP_CENTER" prefWidth="80.0" spacing="20.0" style="-fx-background-color: #1A2130;" BorderPane.alignment="CENTER">
            <padding><Insets bottom="20.0" top="30.0" /></padding>
            <Button onAction="#goBackToDashboard" styleClass="sidebar-icon-btn">
                <graphic><ImageView fitHeight="24.0" fitWidth="24.0"><Image url="@../assets/icon-home.png" /></ImageView></graphic>
            </Button>
            <Region VBox.vgrow="ALWAYS" />
        </VBox>
    </left>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: #f4f7f9; -fx-background: #f4f7f9;">
            <VBox alignment="TOP_CENTER" style="-fx-padding: 40;" VBox.vgrow="ALWAYS">

                <HBox alignment="TOP_CENTER" spacing="40.0" maxWidth="1200.0" VBox.vgrow="ALWAYS">

                    <VBox HBox.hgrow="ALWAYS" maxWidth="700.0" minWidth="450.0" spacing="25.0" style="-fx-background-color: white; -fx-padding: 40; -fx-background-radius: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 15, 0, 0, 5);">

                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <ImageView fitHeight="55.0" preserveRatio="true"><Image url="@../assets/fastpay-logo.png" /></ImageView>
                        </HBox>

                        <Label text="Send Money" textFill="#1a2130"><font><Font name="System Bold" size="28.0" /></font></Label>

                        <HBox alignment="CENTER" spacing="10.0" style="-fx-background-color: #f8fafc; -fx-padding: 5; -fx-background-radius: 30;">
                            <ToggleButton fx:id="fastPayToggle" selected="true" text="FastPay" styleClass="primary-btn" prefWidth="300.0" style="-fx-background-radius: 25;"/>
                            <ToggleButton fx:id="bankToggle" text="Other Bank" style="-fx-background-color: transparent; -fx-text-fill: #4a5568; -fx-font-weight: bold; -fx-cursor: hand;" prefWidth="300.0"/>
                        </HBox>

                        <VBox fx:id="transferFormBox" spacing="25.0">
                            <VBox spacing="8.0">
                                <Label text="Send to (Phone Number)" textFill="#4a5568"><font><Font size="14.0" /></font></Label>
                                <TextField fx:id="phoneField" promptText="03XXXXXXXXX" styleClass="input-field-dark" style="-fx-font-size: 18px;"/>
                            </VBox>

                            <VBox spacing="8.0">
                                <Label text="Amount (PKR)" textFill="#4a5568"><font><Font size="14.0" /></font></Label>
                                <TextField fx:id="amountField" promptText="Rs. 0.00" styleClass="input-field-dark" style="-fx-font-size: 28px; -fx-font-weight: bold;"/>
                            </VBox>

                            <VBox spacing="8.0">
                                <Label text="Pay From Partition" textFill="#4a5568"><font><Font size="14.0" /></font></Label>
                                <ComboBox fx:id="partitionCombo" prefWidth="Infinity" style="-fx-background-color: #f8fafc; -fx-border-color: #cbd5e1; -fx-border-radius: 8; -fx-font-size: 16px; -fx-padding: 8;"/>
                                <Label fx:id="partitionWarningLabel" textFill="#ff6b6b" style="-fx-font-size: 13px;"/>
                            </VBox>

                            <Button fx:id="sendBtn" onAction="#handleSendMoney" text="Next" styleClass="primary-btn" prefWidth="Infinity" prefHeight="55.0" style="-fx-font-size: 18px; -fx-background-radius: 12;"/>
                        </VBox>

                        <VBox fx:id="bankListBox" visible="false" managed="false" spacing="15.0">
                            <TextField fx:id="bankSearchField" promptText="Search bank name..." styleClass="input-field-dark" style="-fx-font-size: 16px; -fx-background-radius: 20;"/>
                            <ListView fx:id="bankListView" prefHeight="350.0" style="-fx-background-color: transparent; -fx-border-color: #cbd5e1; -fx-border-radius: 10;"/>
                        </VBox>

                        <VBox fx:id="otherBankFormBox" visible="false" managed="false" spacing="20.0">
                            <Button text="← Back to Banks" onAction="#showBankList" style="-fx-background-color: transparent; -fx-text-fill: #4da6ff; -fx-cursor: hand; -fx-padding: 0;"/>
                            <Label fx:id="selectedBankLabel" text="Selected Bank" textFill="#1a2130"><font><Font name="System Bold" size="20.0" /></font></Label>

                            <HBox spacing="15.0">
                                <RadioButton fx:id="ibanRadio" selected="true" text="IBAN" style="-fx-font-size: 14px;"/>
                                <RadioButton fx:id="accountRadio" text="Account Number" style="-fx-font-size: 14px;"/>
                            </HBox>

                            <TextField fx:id="bankAccountField" promptText="Enter IBAN (PK...)" styleClass="input-field-dark" style="-fx-font-size: 18px;"/>

                            <VBox spacing="8.0">
                                <Label text="Amount (PKR)" textFill="#4a5568"/>
                                <TextField fx:id="otherBankAmountField" promptText="Rs. 0.00" styleClass="input-field-dark" style="-fx-font-size: 28px; -fx-font-weight: bold;"/>
                            </VBox>

                            <VBox spacing="8.0">
                                <Label text="Pay From Partition" textFill="#4a5568"/>
                                <ComboBox fx:id="otherBankPartitionCombo" prefWidth="Infinity" style="-fx-background-color: #f8fafc; -fx-border-color: #cbd5e1; -fx-border-radius: 8; -fx-padding: 8;"/>
                            </VBox>

                            <Button onAction="#handleOtherBankSend" text="Send (Coming Soon)" style="-fx-background-color: #a0aec0; -fx-text-fill: white; -fx-background-radius: 12; -fx-font-size: 18px;" prefWidth="Infinity" prefHeight="55.0"/>
                        </VBox>

                    </VBox>

                    <VBox HBox.hgrow="ALWAYS" maxWidth="500.0" minWidth="350.0" spacing="25.0" style="-fx-background-color: white; -fx-padding: 40; -fx-background-radius: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 15, 0, 0, 5);">
                        <Label text="FastPay Contacts" textFill="#1a2130"><font><Font name="System Bold" size="20.0" /></font></Label>
                        <Label text="Tap a contact to quick-fill their details." textFill="#a0aec0" wrapText="true" style="-fx-font-size: 14px;"/>

                        <VBox fx:id="contactsContainer" spacing="15.0" />
                    </VBox>

                </HBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>