<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="750.0" prefWidth="1100.0" stylesheets="@../styles/application.css" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="org.example.fastpay.controllers.MobileTopupController">

    <left>
        <VBox alignment="TOP_CENTER" prefWidth="80.0" spacing="20.0" style="-fx-background-color: #1A2130;" BorderPane.alignment="CENTER">
            <padding><Insets bottom="20.0" top="30.0" /></padding>
            <Button onAction="#goBackToDashboard" styleClass="sidebar-icon-btn">
                <graphic><ImageView fitHeight="24.0" fitWidth="24.0"><Image url="@../assets/icon-home.png" /></ImageView></graphic>
            </Button>
            <Region VBox.vgrow="ALWAYS" />
        </VBox>
    </left>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: #f4f7f9; -fx-background: #f4f7f9;">
            <VBox alignment="TOP_CENTER" style="-fx-padding: 40;">

                <VBox maxWidth="600.0" spacing="30.0" style="-fx-background-color: white; -fx-padding: 40; -fx-background-radius: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 15, 0, 0, 5);">

                    <Label text="Mobile Top-Up" textFill="#1a2130"><font><Font name="System Bold" size="26.0" /></font></Label>

                    <VBox spacing="15.0" style="-fx-background-color: #f8fafc; -fx-padding: 20; -fx-background-radius: 15; -fx-border-color: #e2e8f0; -fx-border-radius: 15;">
                        <Label text="1. Select Network" textFill="#1a2130"><font><Font name="System Bold" size="16.0" /></font></Label>
                        <HBox alignment="CENTER_LEFT" spacing="15.0">
                            <ToggleButton fx:id="jazzToggle" styleClass="network-btn" prefWidth="90.0" prefHeight="80.0">
                                <graphic>
                                    <VBox alignment="CENTER" spacing="5.0">
                                        <ImageView fitHeight="30.0" fitWidth="30.0" preserveRatio="true"><Image url="@../assets/jazz-logo.png" /></ImageView>
                                        <Label text="Jazz" style="-fx-font-weight: bold;"/>
                                    </VBox>
                                </graphic>
                            </ToggleButton>
                            <ToggleButton fx:id="zongToggle" styleClass="network-btn" prefWidth="90.0" prefHeight="80.0">
                                <graphic>
                                    <VBox alignment="CENTER" spacing="5.0">
                                        <ImageView fitHeight="30.0" fitWidth="30.0" preserveRatio="true"><Image url="@../assets/zong-logo.png" /></ImageView>
                                        <Label text="Zong" style="-fx-font-weight: bold;"/>
                                    </VBox>
                                </graphic>
                            </ToggleButton>
                            <ToggleButton fx:id="telenorToggle" styleClass="network-btn" prefWidth="90.0" prefHeight="80.0">
                                <graphic>
                                    <VBox alignment="CENTER" spacing="5.0">
                                        <ImageView fitHeight="30.0" fitWidth="30.0" preserveRatio="true"><Image url="@../assets/onic-logo.jpeg" /></ImageView>
                                        <Label text="Onic" style="-fx-font-weight: bold;"/>
                                    </VBox>
                                </graphic>
                            </ToggleButton>
                            <ToggleButton fx:id="ufoneToggle" styleClass="network-btn" prefWidth="90.0" prefHeight="80.0">
                                <graphic>
                                    <VBox alignment="CENTER" spacing="5.0">
                                        <ImageView fitHeight="30.0" fitWidth="30.0" preserveRatio="true"><Image url="@../assets/ufone-logo.png" /></ImageView>
                                        <Label text="Ufone" style="-fx-font-weight: bold;"/>
                                    </VBox>
                                </graphic>
                            </ToggleButton>
                        </HBox>
                    </VBox>

                    <VBox spacing="15.0" style="-fx-background-color: #f8fafc; -fx-padding: 20; -fx-background-radius: 15; -fx-border-color: #e2e8f0; -fx-border-radius: 15;">
                        <Label text="2. Select Type" textFill="#1a2130"><font><Font name="System Bold" size="16.0" /></font></Label>
                        <HBox alignment="CENTER" spacing="10.0" style="-fx-background-color: #e2e8f0; -fx-padding: 5; -fx-background-radius: 10;">
                            <ToggleButton fx:id="balanceToggle" selected="true" text="Balance Load" styleClass="tab-toggle-btn" prefWidth="180.0" />
                            <ToggleButton fx:id="prepaidToggle" text="Prepaid Packages" styleClass="tab-toggle-btn" prefWidth="180.0" />
                            <ToggleButton fx:id="postpaidToggle" text="Postpaid Bill" styleClass="tab-toggle-btn" prefWidth="180.0" />
                        </HBox>
                    </VBox>

                    <VBox spacing="15.0" style="-fx-background-color: #f8fafc; -fx-padding: 20; -fx-background-radius: 15; -fx-border-color: #e2e8f0; -fx-border-radius: 15;">
                        <Label text="3. Details" textFill="#1a2130"><font><Font name="System Bold" size="16.0" /></font></Label>

                        <VBox spacing="5.0">
                            <Label text="Mobile Number" textFill="#4a5568"/>
                            <TextField fx:id="phoneField" promptText="03XXXXXXXXX" styleClass="input-field-dark" style="-fx-font-size: 16px;"/>
                        </VBox>

                        <StackPane>
                            <VBox fx:id="balanceFormBox" spacing="15.0">
                                <VBox spacing="5.0">
                                    <Label text="Amount (PKR)" textFill="#4a5568"/>
                                    <TextField fx:id="amountField" promptText="Rs. 0.00" styleClass="input-field-dark" style="-fx-font-size: 20px; -fx-font-weight: bold;"/>
                                </VBox>
                                <Button onAction="#handleProceed" text="Proceed to Pay" styleClass="primary-btn" prefWidth="Infinity" prefHeight="50.0" style="-fx-font-size: 16px; -fx-background-radius: 10;"/>
                            </VBox>

                            <VBox fx:id="packagesFormBox" visible="false" managed="false" spacing="15.0">
                                <Label text="Available Packages" textFill="#4a5568"/>
                                <ListView fx:id="packagesListView" prefHeight="250.0" style="-fx-background-color: transparent; -fx-border-color: #cbd5e1; -fx-border-radius: 10;"/>
                                <Button onAction="#handleProceed" text="Subscribe Package" styleClass="primary-btn" prefWidth="Infinity" prefHeight="50.0" style="-fx-font-size: 16px; -fx-background-radius: 10;"/>
                            </VBox>
                        </StackPane>
                    </VBox>

                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>