<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" prefWidth="420.0" style="-fx-background-color: white; -fx-background-radius: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 20, 0, 0, 10);" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="org.example.fastpay.controllers.ReceiptController">

    <VBox fx:id="receiptContent" alignment="TOP_CENTER" spacing="15.0" style="-fx-background-color: #f4f7f9; -fx-padding: 30; -fx-background-radius: 20 20 0 0;">

        <Label text="💸" style="-fx-background-color: #ff6b6b; -fx-text-fill: white; -fx-background-radius: 50%; -fx-min-width: 60px; -fx-min-height: 60px; -fx-alignment: center; -fx-font-size: 28px;" />

        <VBox alignment="CENTER" spacing="5.0">
            <Label fx:id="nameLabel" text="[Name]" textFill="#1a2130"><font><Font name="System Bold" size="16.0" /></font></Label>
            <Label text="FastPay Transfer" textFill="#a0aec0"><font><Font size="12.0" /></font></Label>
        </VBox>

        <Label fx:id="amountLabel" text="Rs. 0.00" textFill="#1a2130"><font><Font name="System Bold" size="36.0" /></font></Label>
        <Label fx:id="headerDateLabel" text="[Date]" textFill="#a0aec0"><font><Font size="13.0" /></font></Label>

        <VBox spacing="12.0" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 10;">
            <GridPane hgap="10" vgap="10">
                <columnConstraints>
                    <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" />
                    <ColumnConstraints halignment="RIGHT" hgrow="SOMETIMES" minWidth="10.0" />
                </columnConstraints>
                <Label text="Transfer Amount" textFill="#a0aec0" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <Label fx:id="baseAmountLabel" text="Rs. 0.00" textFill="#1a2130" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                <Label text="Fees &amp; Taxes" textFill="#a0aec0" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <Label text="Rs. 0.00" textFill="#1a2130" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            </GridPane>

            <Region style="-fx-background-color: #f1f5f9; -fx-min-height: 1px; -fx-pref-height: 1px;" />

            <GridPane>
                <columnConstraints>
                    <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" />
                    <ColumnConstraints halignment="RIGHT" hgrow="SOMETIMES" minWidth="10.0" />
                </columnConstraints>
                <Label text="Total Amount" textFill="#a0aec0" />
                <Label fx:id="totalAmountLabel" text="Rs. 0.00" textFill="#1a2130" style="-fx-font-weight: bold;" GridPane.columnIndex="1" />
            </GridPane>
        </VBox>

        <VBox spacing="12.0" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 10;">
            <GridPane hgap="10" vgap="10">
                <columnConstraints>
                    <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" />
                    <ColumnConstraints halignment="RIGHT" hgrow="SOMETIMES" minWidth="10.0" />
                </columnConstraints>
                <Label text="Transaction ID" textFill="#a0aec0" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <Label fx:id="txIdLabel" text="[ID]" textFill="#1a2130" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                <Label text="Transaction Time" textFill="#a0aec0" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <Label fx:id="detailsDateLabel" text="[Date]" textFill="#1a2130" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            </GridPane>
        </VBox>

        <HBox alignment="CENTER" spacing="5.0">
            <VBox.margin><Insets top="10.0" /></VBox.margin>
            <Label text="Paid with" textFill="#a0aec0"><font><Font size="12.0" /></font></Label>
            <ImageView fitHeight="16.0" preserveRatio="true"><Image url="@../assets/fastpay-logo.png" /></ImageView>
        </HBox>
    </VBox>

    <VBox spacing="10.0" style="-fx-padding: 20 30 30 30;">
        <Button onAction="#handleDownload" text="Download Receipt" style="-fx-background-color: #f1f5f9; -fx-text-fill: #1a2130; -fx-font-weight: bold; -fx-background-radius: 10;" prefWidth="Infinity" prefHeight="45.0" />
        <Button onAction="#handleShare" text="Share via WhatsApp" style="-fx-background-color: #25D366; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10;" prefWidth="Infinity" prefHeight="45.0" />
        <Button onAction="#handleClose" text="CLOSE" style="-fx-background-color: transparent; -fx-text-fill: #4da6ff; -fx-font-weight: bold; -fx-cursor: hand;" prefWidth="Infinity" prefHeight="40.0" />
    </VBox>
</VBox>