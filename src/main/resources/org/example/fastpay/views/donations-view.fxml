<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="750.0" prefWidth="1200.0" stylesheets="@../styles/application.css" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="org.example.fastpay.controllers.DonationsController">

    <left>
        <VBox alignment="TOP_CENTER" prefWidth="80.0" spacing="20.0" style="-fx-background-color: #1A2130;" BorderPane.alignment="CENTER">
            <padding><Insets bottom="20.0" top="30.0" /></padding>
            <Button onAction="#goBackToDashboard" styleClass="sidebar-icon-btn">
                <graphic><ImageView fitHeight="24.0" fitWidth="24.0"><Image url="@../assets/icon-home.png" /></ImageView></graphic>
            </Button>
            <Region VBox.vgrow="ALWAYS" />
        </VBox>
    </left>

    <center>
        <VBox alignment="TOP_CENTER" style="-fx-background-color: #f4f7f9; -fx-padding: 40;">

            <HBox alignment="TOP_CENTER" spacing="40.0" maxWidth="1300.0" VBox.vgrow="ALWAYS">

                <VBox HBox.hgrow="ALWAYS" maxWidth="850.0" minWidth="600.0" spacing="25.0" VBox.vgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT" spacing="20.0">
                        <Label text="Make a Donation" textFill="#1a2130"><font><Font name="System Bold" size="28.0" /></font></Label>
                        <Region HBox.hgrow="ALWAYS" />
                        <TextField fx:id="searchField" promptText="Search foundations (e.g., Edhi)..." prefWidth="280.0" styleClass="input-field-dark" style="-fx-font-size: 14px; -fx-background-radius: 20;"/>
                    </HBox>

                    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
                        <FlowPane fx:id="charityGrid" hgap="15.0" vgap="15.0" alignment="TOP_LEFT" style="-fx-padding: 5;" />
                    </ScrollPane>
                </VBox>

                <VBox maxWidth="400.0" minWidth="300.0" spacing="20.0" style="-fx-background-color: white; -fx-padding: 30; -fx-background-radius: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 15, 0, 0, 5);">
                    <Label text="Urgent Appeals" textFill="#1a2130"><font><Font name="System Bold" size="20.0" /></font></Label>
                    <Label text="100% of your donation goes directly to the cause. No platform fees." textFill="#a0aec0" wrapText="true" style="-fx-font-size: 13px; -fx-margin-top: -10px;"/>

                    <VBox fx:id="featuredCampaignsContainer" spacing="15.0" />

                    <Region VBox.vgrow="ALWAYS" />

                    <HBox spacing="10.0" style="-fx-background-color: #f0fdf4; -fx-padding: 15; -fx-background-radius: 10; -fx-border-color: #bbf7d0; -fx-border-radius: 10;">
                        <Label text="📄" style="-fx-font-size: 16px;" />
                        <Label text="All donations made through FastPay are eligible for tax exemption under FBR rules." textFill="#166534" wrapText="true" style="-fx-font-size: 12px; -fx-line-spacing: 3px;"/>
                    </HBox>
                </VBox>

            </HBox>
        </VBox>
    </center>
</BorderPane>