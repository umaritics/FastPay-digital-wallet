<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="750.0" prefWidth="1100.0" stylesheets="@../styles/application.css" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="org.example.fastpay.controllers.RaastController">

    <left>
        <VBox alignment="TOP_CENTER" prefWidth="80.0" spacing="20.0" style="-fx-background-color: #1A2130;" BorderPane.alignment="CENTER">
            <padding><Insets bottom="20.0" top="30.0" /></padding>
            <Button onAction="#goBackToDashboard" styleClass="sidebar-icon-btn">
                <graphic><ImageView fitHeight="24.0" fitWidth="24.0"><Image url="@../assets/icon-home.png" /></ImageView></graphic>
            </Button>
            <Region VBox.vgrow="ALWAYS" />
        </VBox>
    </left>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: #f4f7f9; -fx-background: #f4f7f9;">
            <VBox alignment="TOP_CENTER" style="-fx-padding: 40;">

                <VBox maxWidth="500.0" spacing="30.0" style="-fx-background-color: white; -fx-padding: 40; -fx-background-radius: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 15, 0, 0, 5);">

                    <HBox alignment="CENTER" spacing="20.0">
                        <ImageView fitHeight="30.0" preserveRatio="true"><Image url="@../assets/fastpay-logo.png" /></ImageView>
                        <Label text="✕" textFill="#cbd5e1" style="-fx-font-size: 16px;"/>
                        <ImageView fitHeight="35.0" preserveRatio="true"><Image url="@../assets/icon-raast.png" /></ImageView>
                    </HBox>

                    <Label text="Raast Instant Payments" textFill="#1a2130" alignment="CENTER" prefWidth="Infinity"><font><Font name="System Bold" size="22.0" /></font></Label>

                    <HBox alignment="CENTER" spacing="10.0" style="-fx-background-color: #f8fafc; -fx-padding: 5; -fx-background-radius: 30;">
                        <ToggleButton fx:id="sendRaastToggle" selected="true" text="Make Payment" styleClass="primary-btn" prefWidth="220.0" style="-fx-background-radius: 25;"/>
                        <ToggleButton fx:id="linkRaastToggle" text="Link Raast ID" style="-fx-background-color: transparent; -fx-text-fill: #4a5568; -fx-font-weight: bold; -fx-cursor: hand;" prefWidth="220.0"/>
                    </HBox>

                    <VBox fx:id="sendFormBox" spacing="20.0">
                        <VBox spacing="8.0">
                            <Label text="Raast ID (Mobile Number / IBAN)" textFill="#4a5568"><font><Font size="13.0" /></font></Label>
                            <TextField fx:id="raastIdField" promptText="Enter 11-digit Phone or IBAN" styleClass="input-field-dark" style="-fx-font-size: 16px;"/>
                        </VBox>

                        <VBox spacing="8.0">
                            <Label text="Amount (PKR)" textFill="#4a5568"><font><Font size="13.0" /></font></Label>
                            <TextField fx:id="amountField" promptText="Rs. 0.00" styleClass="input-field-dark" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
                        </VBox>

                        <Button onAction="#handleSendPayment" text="Send via Raast" styleClass="primary-btn" prefWidth="Infinity" prefHeight="50.0" style="-fx-font-size: 16px; -fx-background-radius: 10;"/>
                    </VBox>

                    <VBox fx:id="linkFormBox" visible="false" managed="false" alignment="CENTER" spacing="20.0">
                        <Label text="Link your FastPay account to Raast to receive funds instantly from any bank in Pakistan." textFill="#a0aec0" wrapText="true" textAlignment="CENTER" style="-fx-line-spacing: 5px;"/>

                        <VBox spacing="8.0" alignment="CENTER_LEFT" prefWidth="Infinity" style="-fx-background-color: #f8fafc; -fx-padding: 15; -fx-background-radius: 10; -fx-border-color: #e2e8f0; -fx-border-radius: 10;">
                            <Label text="Your Default Raast ID:" textFill="#4a5568"/>
                            <Label fx:id="userPhoneLabel" text="Loading..." textFill="#1a2130"><font><Font name="System Bold" size="18.0" /></font></Label>
                        </VBox>

                        <Button onAction="#handleLinkRaast" text="Link My Number" style="-fx-background-color: #25D366; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-font-size: 16px;" prefWidth="Infinity" prefHeight="50.0"/>
                    </VBox>

                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>