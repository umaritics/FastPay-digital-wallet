<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="750.0" prefWidth="1100.0" stylesheets="@../styles/application.css" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="org.example.fastpay.controllers.MTagController">

    <left>
        <VBox alignment="TOP_CENTER" prefWidth="80.0" spacing="20.0" style="-fx-background-color: #1A2130;" BorderPane.alignment="CENTER">
            <padding><Insets bottom="20.0" top="30.0" /></padding>
            <Button onAction="#goBackToDashboard" styleClass="sidebar-icon-btn">
                <graphic><ImageView fitHeight="24.0" fitWidth="24.0"><Image url="@../assets/icon-home.png" /></ImageView></graphic>
            </Button>
            <Region VBox.vgrow="ALWAYS" />
        </VBox>
    </left>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: #f4f7f9; -fx-background: #f4f7f9;">
            <VBox alignment="TOP_CENTER" style="-fx-padding: 40;">

                <VBox maxWidth="500.0" spacing="25.0" style="-fx-background-color: white; -fx-padding: 40; -fx-background-radius: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 15, 0, 0, 5);">

                    <HBox alignment="CENTER" spacing="20.0">
                        <ImageView fitHeight="30.0" preserveRatio="true"><Image url="@../assets/fastpay-logo.png" /></ImageView>
                        <Label text="✕" textFill="#cbd5e1" style="-fx-font-size: 16px;"/>
                        <ImageView fitHeight="40.0" preserveRatio="true"><Image url="@../assets/icon-m-tag-top-up.png" /></ImageView>
                    </HBox>

                    <VBox alignment="CENTER" spacing="5.0">
                        <Label text="M-Tag Recharge" textFill="#1a2130"><font><Font name="System Bold" size="24.0" /></font></Label>
                        <Label text="Enter your 8-digit M-Tag ID to top up your vehicle." textFill="#a0aec0" wrapText="true" textAlignment="CENTER"/>
                    </VBox>

                    <VBox spacing="20.0" style="-fx-padding: 10 0 0 0;">
                        <VBox spacing="8.0">
                            <Label text="M-Tag ID" textFill="#4a5568"><font><Font size="13.0" /></font></Label>
                            <TextField fx:id="mtagIdField" promptText="e.g., 12345678" styleClass="input-field-dark" style="-fx-font-size: 18px; -fx-letter-spacing: 2px;"/>
                        </VBox>

                        <VBox spacing="8.0">
                            <Label text="Recharge Amount (PKR)" textFill="#4a5568"><font><Font size="13.0" /></font></Label>
                            <TextField fx:id="amountField" promptText="Rs. 0.00" styleClass="input-field-dark" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
                        </VBox>

                        <Button onAction="#handleTopup" text="Proceed to Pay" styleClass="primary-btn" prefWidth="Infinity" prefHeight="55.0" style="-fx-font-size: 16px; -fx-background-radius: 12;"/>
                    </VBox>

                    <HBox spacing="10.0" style="-fx-background-color: #f8fafc; -fx-padding: 15; -fx-background-radius: 10; -fx-border-color: #e2e8f0; -fx-border-radius: 10;">
                        <Label text="Minimum recharge amount is Rs. 100. Balance reflects instantly." textFill="#64748b" wrapText="true" style="-fx-font-size: 12px; -fx-line-spacing: 4px;"/>
                    </HBox>

                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>