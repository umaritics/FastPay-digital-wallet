<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="750.0" prefWidth="1100.0" stylesheets="@../styles/application.css" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="org.example.fastpay.controllers.CardController">

    <left>
        <VBox alignment="TOP_CENTER" prefWidth="80.0" spacing="20.0" style="-fx-background-color: #1A2130;" BorderPane.alignment="CENTER">
            <padding><Insets bottom="20.0" top="30.0" /></padding>
            <Button onAction="#goBackToDashboard" styleClass="sidebar-icon-btn">
                <graphic><ImageView fitHeight="24.0" fitWidth="24.0"><Image url="@../assets/icon-home.png" /></ImageView></graphic>
                <tooltip><Tooltip text="Home" /></tooltip>
            </Button>
            <Button styleClass="sidebar-icon-btn">
                <graphic><ImageView fitHeight="24.0" fitWidth="24.0"><Image url="@../assets/icon-profile.png" /></ImageView></graphic>
                <tooltip><Tooltip text="Profile" /></tooltip>
            </Button>
            <Button styleClass="sidebar-icon-btn">
                <graphic><ImageView fitHeight="24.0" fitWidth="24.0"><Image url="@../assets/icon-history.png" /></ImageView></graphic>
                <tooltip><Tooltip text="History" /></tooltip>
            </Button>
            <Region VBox.vgrow="ALWAYS" />
        </VBox>
    </left>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: #f4f7f9; -fx-background: #f4f7f9;">
            <StackPane style="-fx-padding: 40;">

                <HBox fx:id="orderCardView" spacing="40.0" alignment="CENTER" visible="false">
                    <VBox spacing="15.0" prefWidth="400.0" style="-fx-background-color: white; -fx-padding: 30; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);">
                        <Label text="Get Your FastPay Card" textFill="#1a2130"><font><Font name="System Bold" size="24.0" /></font></Label>
                        <Label text="Select a card tier and enter your delivery address." textFill="#4a5568" wrapText="true" />

                        <Label text="Card Tier:" textFill="#1a2130"><font><Font name="System Bold" size="14.0" /></font></Label>
                        <ComboBox fx:id="cardTierCombo" prefWidth="Infinity" styleClass="input-field" />

                        <Label text="Delivery Address:" textFill="#1a2130"><font><Font name="System Bold" size="14.0" /></font></Label>
                        <TextArea fx:id="addressInput" prefRowCount="3"  style="-fx-text-fill: black;" />

                        <Label fx:id="orderErrorLabel" textFill="#ff6b6b" wrapText="true" />
                        <Button text="Pay &amp; Order Card" onAction="#handleOrderCard" styleClass="primary-btn" maxWidth="Infinity" />
                    </VBox>

                    <VBox spacing="20.0" prefWidth="400.0">
                        <VBox prefHeight="220.0" styleClass="fintech-card" style="-fx-padding: 25;">
                            <StackPane style="-fx-background-radius: 5;"><ImageView fitHeight="30.0" preserveRatio="true"><Image url="@../assets/fastpay-logo-whitebg.png"/></ImageView></StackPane>
                            <Region VBox.vgrow="ALWAYS" />
                            <Label text="**** **** **** ****" style="-fx-text-fill: white; -fx-letter-spacing: 2px; -fx-font-weight: bold; -fx-font-size: 24px;"><font><Font name="System Bold" size="22.0" /></font></Label>
                            <HBox>
                                <Label fx:id="previewNameLabel" text="YOUR NAME" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16px;" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label text="**/**" style="-fx-text-fill: white; -fx-font-weight: bold;" />
                            </HBox>
                        </VBox>
                        <VBox spacing="10.0" style="-fx-background-color: #e2e8f0; -fx-padding: 20; -fx-background-radius: 10;">
                            <Label text="Tier Pricing &amp; Policies" textFill="#1a2130"><font><Font name="System Bold" size="14.0" /></font></Label>
                            <Label text="• Visa: Standard Limits (Free)&#10;• Mastercard: Higher POS Limits (Rs. 600)&#10;• PayPal: Global Routing (Rs. 1200)" textFill="#4a5568" />
                            <Label text="* Fees are deducted instantly from your General Partition." textFill="#ff6b6b" wrapText="true"><font><Font size="11.0" /></font></Label>
                        </VBox>
                    </VBox>
                </HBox>

                <VBox fx:id="activeCardView" spacing="30.0" visible="false" maxWidth="900.0">
                    <Label text="Card Management" textFill="#1a2130"><font><Font name="System Bold" size="28.0" /></font></Label>

                    <HBox spacing="40.0">
                        <VBox prefWidth="420.0" prefHeight="240.0" styleClass="fintech-card" style="-fx-padding: 30;">
                            <HBox alignment="CENTER_LEFT">
                                <StackPane style="-fx-background-radius: 15;"><ImageView fitHeight="30.0" preserveRatio="true"><Image url="@../assets/fastpay-logo-whitebg.png"/></ImageView></StackPane>
                                <Region HBox.hgrow="ALWAYS" />
                                <ImageView fx:id="cardBrandIcon" fitHeight="35.0" preserveRatio="true" />                            </HBox>
                            <Region VBox.vgrow="ALWAYS" />
                            <Label fx:id="cardNumberLabel" text="**** **** **** ****" style="-fx-text-fill: white; -fx-letter-spacing: 2px; -fx-font-weight: bold; -fx-font-size: 24px;" />
                            <HBox spacing="40.0" alignment="BOTTOM_LEFT">
                                <VBox.margin><Insets top="15.0" /></VBox.margin>
                                <Label fx:id="cardNameLabel" text="MUHAMMAD UMAR" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16px;" />
                                <Region HBox.hgrow="ALWAYS" />
                                <VBox>
                                    <Label text="EXP" style="-fx-text-fill: #a0aec0; -fx-font-size: 10px;" />
                                    <Label fx:id="cardExpiryLabel" text="**/**" style="-fx-text-fill: white; -fx-font-weight: bold;" />
                                </VBox>
                                <VBox>
                                    <Label text="CVV" style="-fx-text-fill: #a0aec0; -fx-font-size: 10px;" />
                                    <Label fx:id="cardCvvLabel" text="***" style="-fx-text-fill: white; -fx-font-weight: bold;" />
                                </VBox>
                            </HBox>
                        </VBox>

                        <VBox spacing="20.0" alignment="CENTER_LEFT" HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-padding: 30; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);">
                            <Label text="Status:" textFill="#4a5568" />
                            <Label fx:id="cardStatusLabel" text="ACTIVE" textFill="#4caf50"><font><Font name="System Bold" size="24.0" /></font></Label>
                            <HBox spacing="20.0">
                                <VBox alignment="CENTER" spacing="5.0">
                                    <ToggleButton fx:id="freezeToggleBtn" styleClass="circle-btn" onAction="#handleFreezeToggle" text="❄">
                                        <tooltip><Tooltip text="Freeze Card" /></tooltip>
                                    </ToggleButton>
                                    <Label text="Freeze" textFill="#4a5568"><font><Font size="12.0" /></font></Label>
                                </VBox>
                                <VBox alignment="CENTER" spacing="5.0">
                                    <ToggleButton fx:id="revealToggleBtn" styleClass="circle-btn" onAction="#handleRevealToggle" text="👁">
                                        <tooltip><Tooltip text="Reveal Details" /></tooltip>
                                    </ToggleButton>
                                    <Label text="Reveal" textFill="#4a5568"><font><Font size="12.0" /></font></Label>
                                </VBox>
                            </HBox>
                        </VBox>
                    </HBox>

                    <HBox spacing="40.0">
                        <VBox spacing="15.0" prefWidth="420.0" style="-fx-background-color: white; -fx-padding: 30; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);">
                            <Label text="Card Limits" textFill="#1a2130"><font><Font name="System Bold" size="20.0" /></font></Label>

                            <Label text="DAILY CASH WITHDRAWALS" textFill="#a0aec0"><font><Font name="System Bold" size="12.0" /></font></Label>
                            <HBox><Label text="Rs. 0" textFill="#1a2130" /><Region HBox.hgrow="ALWAYS" /><Label text="Rs. 50,000" textFill="#1a2130" /></HBox>
                            <ProgressBar progress="0.0" prefWidth="Infinity" styleClass="custom-progress-bar" />

                            <Label text="DAILY ONLINE TRANSACTIONS" textFill="#a0aec0"><VBox.margin><Insets top="10.0" /></VBox.margin><font><Font name="System Bold" size="12.0" /></font></Label>
                            <HBox><Label text="Rs. 1,000" textFill="#1a2130" /><Region HBox.hgrow="ALWAYS" /><Label text="Rs. 200,000" textFill="#1a2130" /></HBox>
                            <ProgressBar progress="0.05" prefWidth="Infinity" styleClass="custom-progress-bar" />

                            <Label text="DAILY POS TRANSACTIONS" textFill="#a0aec0"><VBox.margin><Insets top="10.0" /></VBox.margin><font><Font name="System Bold" size="12.0" /></font></Label>
                            <HBox><Label text="Rs. 15,000" textFill="#1a2130" /><Region HBox.hgrow="ALWAYS" /><Label text="Rs. 400,000" textFill="#1a2130" /></HBox>
                            <ProgressBar progress="0.0375" prefWidth="Infinity" styleClass="custom-progress-bar" />
                        </VBox>

                        <VBox spacing="15.0" HBox.hgrow="ALWAYS" style="-fx-background-color: white; -fx-padding: 30; -fx-background-radius: 15; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 10, 0, 0, 5);">
                            <Label text="Card Transactions" textFill="#1a2130"><font><Font name="System Bold" size="20.0" /></font></Label>
                            <Label text="13 APRIL 2026" textFill="#a0aec0"><font><Font name="System Bold" size="12.0" /></font></Label>
                            <HBox alignment="CENTER_LEFT" spacing="15.0">
                                <Label text="⛽" style="-fx-font-size: 24px;" />
                                <VBox><Label text="PSO ISLAMABAD" textFill="#1a2130"><font><Font name="System Bold" size="14.0" /></font></Label><Label text="POS Transaction" textFill="#a0aec0" /></VBox>
                                <Region HBox.hgrow="ALWAYS" />
                                <VBox alignment="CENTER_RIGHT"><Label text="05:16 PM" textFill="#a0aec0" /><Label text="- Rs. 1,000" textFill="#ff6b6b"><font><Font name="System Bold" size="14.0" /></font></Label></VBox>
                            </HBox>
                            <Separator />
                            <Label text="06 APRIL 2026" textFill="#a0aec0"><font><Font name="System Bold" size="12.0" /></font></Label>
                            <HBox alignment="CENTER_LEFT" spacing="15.0">
                                <Label text="🏧" style="-fx-font-size: 24px;" />
                                <VBox><Label text="Cash Withdrawal" textFill="#1a2130"><font><Font name="System Bold" size="14.0" /></font></Label><Label text="Meezan Bank ATM" textFill="#a0aec0" /></VBox>
                                <Region HBox.hgrow="ALWAYS" />
                                <VBox alignment="CENTER_RIGHT"><Label text="02:40 PM" textFill="#a0aec0" /><Label text="- Rs. 3,000" textFill="#ff6b6b"><font><Font name="System Bold" size="14.0" /></font></Label></VBox>
                            </HBox>
                        </VBox>
                    </HBox>

                </VBox>
            </StackPane>
        </ScrollPane>
    </center>
</BorderPane>