<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="750.0" prefWidth="1100.0" stylesheets="@../styles/application.css" xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:controller="org.example.fastpay.controllers.ProfileController">

    <left>
        <VBox alignment="TOP_CENTER" prefWidth="80.0" spacing="20.0" style="-fx-background-color: #1A2130;" BorderPane.alignment="CENTER">
            <padding><Insets bottom="20.0" top="30.0" /></padding>
            <Button onAction="#goBackToDashboard" styleClass="sidebar-icon-btn">
                <graphic><ImageView fitHeight="24.0" fitWidth="24.0"><Image url="@../assets/icon-home.png" /></ImageView></graphic>
            </Button>
            <Region VBox.vgrow="ALWAYS" />
        </VBox>
    </left>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: #f4f7f9; -fx-background: #f4f7f9;">
            <VBox alignment="TOP_CENTER" style="-fx-padding: 40;">

                <VBox maxWidth="600.0" spacing="30.0" style="-fx-background-color: white; -fx-padding: 40; -fx-background-radius: 20; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 15, 0, 0, 5);">

                    <HBox alignment="CENTER_LEFT" spacing="20.0">
                        <ImageView fitHeight="35.0" preserveRatio="true"><Image url="@../assets/fastpay-logo.png" /></ImageView>
                        <Region HBox.hgrow="ALWAYS" />
                        <Label text="My Profile" textFill="#1a2130"><font><Font name="System Bold" size="24.0" /></font></Label>
                    </HBox>

                    <Separator style="-fx-background-color: #f1f5f9;"/>

                    <HBox alignment="CENTER_LEFT" spacing="20.0">
                        <Label text="👤" style="-fx-font-size: 50px; -fx-background-color: #f8fafc; -fx-background-radius: 40; -fx-padding: 10; -fx-min-width: 80px; -fx-min-height: 80px; -fx-alignment: center;"/>
                        <VBox alignment="CENTER_LEFT" spacing="5.0">
                            <Label fx:id="fullNameLabel" text="Loading..." textFill="#1a2130"><font><Font name="System Bold" size="22.0" /></font></Label>
                            <Label text="Verified FastPay User" textFill="#25D366" style="-fx-font-weight: bold; -fx-font-size: 13px;"/>
                        </VBox>
                    </HBox>

                    <VBox spacing="15.0" style="-fx-background-color: #f8fafc; -fx-padding: 25; -fx-background-radius: 15; -fx-border-color: #e2e8f0; -fx-border-radius: 15;">
                        <Label text="Account Information" textFill="#1a2130"><font><Font name="System Bold" size="16.0" /></font></Label>

                        <GridPane hgap="20.0" vgap="15.0">
                            <columnConstraints>
                                <ColumnConstraints prefWidth="120.0" />
                                <ColumnConstraints hgrow="ALWAYS" />
                            </columnConstraints>

                            <Label text="Email Address" textFill="#64748b" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                            <Label fx:id="emailLabel" text="Loading..." textFill="#1a2130" style="-fx-font-weight: bold;" GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                            <Label text="Mobile Number" textFill="#64748b" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                            <Label fx:id="phoneLabel" text="Loading..." textFill="#1a2130" style="-fx-font-weight: bold;" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

                            <Label text="CNIC" textFill="#64748b" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                            <Label fx:id="cnicLabel" text="Loading..." textFill="#1a2130" style="-fx-font-weight: bold;" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

                            <Label text="Joined Date" textFill="#64748b" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                            <Label fx:id="joinedLabel" text="Loading..." textFill="#1a2130" style="-fx-font-weight: bold;" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                        </GridPane>
                    </VBox>

                    <VBox spacing="15.0" style="-fx-background-color: #f0fdf4; -fx-padding: 25; -fx-background-radius: 15; -fx-border-color: #bbf7d0; -fx-border-radius: 15;">
                        <Label text="Receiving Details" textFill="#166534"><font><Font name="System Bold" size="16.0" /></font></Label>

                        <VBox spacing="5.0">
                            <Label text="Your FastPay IBAN" textFill="#166534"/>
                            <TextField fx:id="ibanField" editable="false" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-background-color: white; -fx-border-color: #bbf7d0; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 10; -fx-text-fill: #1a2130;"/>
                        </VBox>

                        <Button onAction="#handleShareWhatsApp" text="  Share IBAN via WhatsApp" style="-fx-background-color: #25D366; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10; -fx-cursor: hand; -fx-font-size: 16px;" prefWidth="Infinity" prefHeight="50.0" >
                            <graphic><Label text="💬" style="-fx-font-size: 18px;"/></graphic>
                        </Button>
                    </VBox>

                    <Button text="Log Out" style="-fx-background-color: transparent; -fx-border-color: #ef4444; -fx-text-fill: #ef4444; -fx-font-weight: bold; -fx-border-radius: 10; -fx-cursor: hand;" prefWidth="Infinity" prefHeight="45.0" />

                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>